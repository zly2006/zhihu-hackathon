# 服务端配置，不要使用 NEXT_PUBLIC_ 前缀
MODEL_PROVIDER=opencode
OPENCODE_API_KEY=
OPENCODE_ENDPOINT=https://opencode.ai/zen/go/v1/chat/completions
OPENCODE_MODEL=deepseek-flash
OPENCODE_REASONING_EFFORT=none

# 知乎 OAuth（只在服务端使用，不能使用 NEXT_PUBLIC_ 前缀）
ZHIHU_OAUTH_APP_ID=460
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=https://restart-life.ai2.fintechedu.cn/auth/callback
# 某些知乎用户信息接口还要求 Access Secret；没有时留空
ZHIHU_OAUTH_ACCESS_SECRET=
# 兼容旧版模板；如果已配置 ZHIHU_ACCESS_SECRET，可不重复填写
ZHIHU_ACCESS_SECRET=
ZHIHU_OAUTH_USERINFO_URL=https://openapi.zhihu.com/user

# off 上 PostgreSQL 的独立 demo 数据库（不要复用 legacy 的只读 DSN）
LAMPLIGHT_DATABASE_URL=postgresql://svc_lamplight_app:change-me@host.docker.internal:15432/svc_lamplight
LAMPLIGHT_DATABASE_SSL=disable
# 迁移使用 owner 角色，运行时只使用上面的 app 角色
LAMPLIGHT_MIGRATION_DATABASE_URL=postgresql://svc_lamplight_owner:change-me@host.docker.internal:15432/svc_lamplight
