{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/zhihu-hackathon/spark-decision-extraction-v1.schema.json",
  "title": "Spark decision extraction result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "decision_object",
    "context",
    "decision",
    "action",
    "outcome",
    "evidence_quote",
    "confidence",
    "reason"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["ACCEPT", "REJECT"]
    },
    "decision_object": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "context": {
      "type": ["string", "null"]
    },
    "decision": {
      "type": ["string", "null"]
    },
    "action": {
      "type": ["string", "null"]
    },
    "outcome": {
      "type": ["string", "null"]
    },
    "evidence_quote": {
      "type": ["string", "null"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "ACCEPT"}
        }
      },
      "then": {
        "properties": {
          "decision_object": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "evidence_quote": {"type": "string", "minLength": 1},
          "reason": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "REJECT"}
        }
      },
      "then": {
        "properties": {
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
